# Configurações da Aplicação
PROJECT_NAME="Motor de Preços 2.0 - SQL Edition"
VERSION="4.0.0-sql"
API_V1_STR="/api/v1"

# Conexão do Banco de Dados Assíncrono
# Para PostgreSQL em produção: postgresql+asyncpg://usuario:senha@localhost:5432/pricing_db
# Para SQLite local em desenvolvimento:
DATABASE_URL="sqlite+aiosqlite:///./pricing_dev.db"

# Regras de Precificação por Defeito
DEFAULT_MIN_MARGIN=0.15
DEFAULT_TARGET_MARGIN=0.30